{
  "name": "navidrome-replacement",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "desktop:build": "mise run desktop:build",
    "desktop:dev": "mise run desktop:dev",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:core": "turbo run test --filter=!@repo/desktop",
    "test:desktop": "pnpm --filter @repo/desktop test",
    "test:e2e": "turbo run test:e2e --filter=web",
    "test:e2e:hls": "cd server && RUN_HLS_BROWSER_INTEGRATION=1 go test ./internal/modules/radio -run TestBrowserHLSProxyIntegration -count=1 -v",
    "generate": "turbo run generate",
    "check": "turbo run check",
    "start": "mise run start"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "browserslist": "4.28.8",
      "nanoid": "3.3.18",
      "postcss": "8.5.26"
    }
  }
}
