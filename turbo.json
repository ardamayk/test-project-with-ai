{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "check": {},
    "typecheck": {},
    "test": {},
    "test:unit": {},
    "test:e2e": {
      "cache": false
    },
    "test:integration": {
      "cache": false
    },
    "generate": {
      "cache": false,
      "outputs": ["src/generated/**", "../../server/internal/api/gen/**"]
    }
  }
}
