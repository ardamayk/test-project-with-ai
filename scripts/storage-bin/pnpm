#!/usr/bin/env bash
set -euo pipefail
kind=build
for argument in "$@"; do
  case "$argument" in
    playwright) kind=browser; break ;;
    vitest) kind=test; break ;;
  esac
done
exec bash "$(dirname -- "${BASH_SOURCE[0]}")/../run-with-storage.sh" "$kind" "${EARTHLY_REAL_PNPM:?pnpm tool path is missing; run through Mise}" "$@"
